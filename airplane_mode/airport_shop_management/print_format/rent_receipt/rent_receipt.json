{
 "align_labels_right": 0,
 "creation": "2026-10-08 00:00:00.000000",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Shop Rent Payment",
 "doctype": "Print Format",
 "engine": "jinja",
 "html": "<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 750px; margin: 0 auto; padding: 30px; border: 2px solid #1a365d; border-radius: 10px; background: #ffffff; color: #2d3748;\">\n    <div style=\"text-align: center; border-bottom: 2px solid #1a365d; padding-bottom: 20px; margin-bottom: 25px;\">\n        <h2 style=\"margin: 0; color: #1a365d; text-transform: uppercase; letter-spacing: 2px; font-size: 24px;\">Airport Shop Rent Receipt</h2>\n        <p style=\"margin: 5px 0 0 0; color: #718096; font-size: 14px;\">Official Airport Authority Lease Payment Receipt</p>\n    </div>\n\n    <div style=\"display: flex; justify-content: space-between; margin-bottom: 25px; font-size: 14px;\">\n        <div>\n            <p style=\"margin: 2px 0;\"><strong>Receipt Number:</strong> {{ doc.name }}</p>\n            <p style=\"margin: 2px 0;\"><strong>Contract Ref:</strong> {{ doc.contract }}</p>\n            <p style=\"margin: 2px 0;\"><strong>Billing Month:</strong> <span style=\"font-weight: 600;\">{{ doc.rent_month }}</span></p>\n            <p style=\"margin: 2px 0;\"><strong>Due Date:</strong> {{ frappe.utils.formatdate(doc.due_date) if doc.due_date else '-' }}</p>\n        </div>\n        <div style=\"text-align: right;\">\n            <p style=\"margin: 2px 0;\"><strong>Payment Date:</strong> {{ frappe.utils.formatdate(doc.payment_date) if doc.payment_date else '-' }}</p>\n            <p style=\"margin: 2px 0;\"><strong>Payment Mode:</strong> {{ doc.payment_mode or '-' }}</p>\n            <p style=\"margin: 2px 0;\"><strong>Transaction Ref:</strong> {{ doc.transaction_reference or '-' }}</p>\n            <p style=\"margin: 2px 0;\"><strong>Status:</strong> \n                {% if doc.payment_status == 'Paid' %}\n                    <span style=\"display: inline-block; padding: 3px 10px; background: #38a169; color: #ffffff; font-weight: bold; border-radius: 4px; font-size: 12px; text-transform: uppercase;\">PAID</span>\n                {% elif doc.payment_status == 'Partially Paid' %}\n                    <span style=\"display: inline-block; padding: 3px 10px; background: #dd6b20; color: #ffffff; font-weight: bold; border-radius: 4px; font-size: 12px; text-transform: uppercase;\">PARTIALLY PAID</span>\n                {% elif doc.payment_status == 'Overdue' %}\n                    <span style=\"display: inline-block; padding: 3px 10px; background: #e53e3e; color: #ffffff; font-weight: bold; border-radius: 4px; font-size: 12px; text-transform: uppercase;\">OVERDUE</span>\n                {% else %}\n                    <span style=\"display: inline-block; padding: 3px 10px; background: #d69e2e; color: #ffffff; font-weight: bold; border-radius: 4px; font-size: 12px; text-transform: uppercase;\">PENDING</span>\n                {% endif %}\n            </p>\n        </div>\n    </div>\n\n    <div style=\"background: #f7fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 18px; margin-bottom: 25px;\">\n        <h4 style=\"margin: 0 0 12px 0; color: #2b6cb0; font-size: 16px; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px;\">Property & Tenant Information</h4>\n        <table style=\"width: 100%; font-size: 14px; border-collapse: collapse;\">\n            <tr>\n                <td style=\"padding: 5px 0; width: 22%; color: #4a5568;\"><strong>Airport:</strong></td>\n                <td style=\"padding: 5px 0; width: 28%;\">{{ doc.airport }}</td>\n                <td style=\"padding: 5px 0; width: 22%; color: #4a5568;\"><strong>Tenant Name:</strong></td>\n                <td style=\"padding: 5px 0; width: 28%;\">{{ doc.tenant_name or doc.tenant }}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 5px 0; color: #4a5568;\"><strong>Shop Number:</strong></td>\n                <td style=\"padding: 5px 0;\">{{ doc.shop_number or '-' }}</td>\n                <td style=\"padding: 5px 0; color: #4a5568;\"><strong>Tenant Email:</strong></td>\n                <td style=\"padding: 5px 0;\">{{ doc.tenant_email or '-' }}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 5px 0; color: #4a5568;\"><strong>Shop Name:</strong></td>\n                <td style=\"padding: 5px 0;\">{{ doc.shop_name or '-' }}</td>\n                <td style=\"padding: 5px 0; color: #4a5568;\"><strong>Shop ID:</strong></td>\n                <td style=\"padding: 5px 0;\">{{ doc.shop }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <div style=\"margin-bottom: 25px;\">\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n            <thead>\n                <tr style=\"background: #edf2f7; text-align: left; border-bottom: 2px solid #cbd5e0;\">\n                    <th style=\"padding: 10px;\">Description</th>\n                    <th style=\"padding: 10px; text-align: right;\">Amount Due</th>\n                    <th style=\"padding: 10px; text-align: right;\">Amount Paid</th>\n                    <th style=\"padding: 10px; text-align: right;\">Balance</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n                    <td style=\"padding: 12px 10px;\">Monthly Shop Lease Rent ({{ doc.rent_month }})</td>\n                    <td style=\"padding: 12px 10px; text-align: right;\">₹{{ \"{:,.2f}\".format(doc.amount_due) }}</td>\n                    <td style=\"padding: 12px 10px; text-align: right; font-weight: bold; color: #2b6cb0;\">₹{{ \"{:,.2f}\".format(doc.amount_paid) }}</td>\n                    <td style=\"padding: 12px 10px; text-align: right;\">₹{{ \"{:,.2f}\".format(doc.amount_due - doc.amount_paid) }}</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <div style=\"background: #1a365d; color: #ffffff; border-radius: 8px; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;\">\n        <span style=\"font-size: 15px; text-transform: uppercase; letter-spacing: 1px;\">Total Amount Received</span>\n        <span style=\"font-size: 24px; font-weight: bold;\">₹{{ \"{:,.2f}\".format(doc.amount_paid) }}</span>\n    </div>\n\n    {% if doc.remarks %}\n    <div style=\"margin-bottom: 25px; font-size: 13px; color: #4a5568;\">\n        <strong>Remarks:</strong> {{ doc.remarks }}\n    </div>\n    {% endif %}\n\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-end; margin-top: 40px; padding-top: 20px; border-top: 1px dashed #cbd5e0; font-size: 12px; color: #718096;\">\n        <div>\n            <p style=\"margin: 0;\">This is an authorized system-generated lease receipt.</p>\n            <p style=\"margin: 2px 0 0 0;\">Airport Commercial Tenancy Office</p>\n        </div>\n        <div style=\"text-align: right;\">\n            <div style=\"width: 200px; border-bottom: 1px solid #4a5568; margin-bottom: 5px;\"></div>\n            <p style=\"margin: 0;\">Authorized Airport Authority Signature</p>\n        </div>\n    </div>\n</div>",
 "line_breaks": 0,
 "modified": "2026-10-08 00:00:00.000000",
 "modified_by": "Administrator",
